{
  "name": "codebase-audit-kit",
  "version": "0.1.0",
  "description": "Token-efficient codebase audit CLI. Cheap signals first, targeted reads later.",
  "author": "Cursive Media",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Theycallmeholla/codebase-audit-kit.git"
  },
  "keywords": [
    "audit",
    "cli",
    "codebase",
    "security",
    "triage",
    "developer-tools"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "bin": {
    "audit-kit": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run check && npm run build && npm run test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
